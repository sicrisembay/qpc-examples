<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.1" links="0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <framework name="qpc"/>
 <package name="Blinky" stereotype="0x02">
  <class name="Blinky" superclass="qpc::QActive">
   <attribute name="stack_sto[256]" type="uint16_t" visibility="0x02" properties="0x00"/>
   <attribute name="queue_sto[16]" type="event_t" visibility="0x02" properties="0x00"/>
   <attribute name="timeEvt" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <statechart properties="0x02">
    <initial target="../1">
     <action>Q_UNUSED_PAR(par);

LED_init();

// arm the time event to expire in half a second and every half second
QTimeEvt_armX(&amp;me-&gt;timeEvt, 500U, 500U);</action>
     <initial_glyph conn="26,10,4,0,5">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="off">
     <entry>LED_off(LED_1);</entry>
     <tran trig="TIMEOUT" target="../../2">
      <tran_glyph conn="22,24,3,1,33,11,-2">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="22,15,31,13">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state name="on">
     <entry>LED_on(LED_1);</entry>
     <tran trig="TIMEOUT" target="../../1">
      <tran_glyph conn="22,40,3,1,35,-19,-4">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="22,31,31,13">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state_diagram size="80,50"/>
   </statechart>
  </class>
  <operation name="Blinky_ctor" type="void" visibility="0x00" properties="0x00">
   <code>Blinky * const me = &amp;Blinky_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;Blinky_initial));
QTimeEvt_ctorX(&amp;me-&gt;timeEvt, &amp;me-&gt;super, TIMEOUT_SIG, 0U);

QActive_setAttr(&amp;me-&gt;super, TASK_NAME_ATTR, Q_this_module_);

QACTIVE_START(&amp;me-&gt;super,
              (QPrioSpec)(1),
              (QEvt **)me-&gt;queue_sto, // dirty casting
              Q_DIM(me-&gt;queue_sto),
              me-&gt;stack_sto,
              Q_DIM(me-&gt;stack_sto),
              (void *)0);
</code>
  </operation>
  <attribute name="AO_Blinky" type="QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;Blinky_inst.super;</code>
  </attribute>
  <directory name=".">
   <file name="blinky.h">
    <text>#ifndef BLINKY_H_
#define BLINKY_H_

#include &quot;bsp.h&quot;

enum BlinkySignals {
    DUMMY_SIG = MAX_BSP_PUB_SIG,
    MAX_PUB_SIG,          // the last published signal

    TIMEOUT_SIG,
    MAX_SIG               // the last signal
};

$declare(Blinky::Blinky_ctor)
$declare(Blinky::AO_Blinky)

#endif // BLINKY_H_</text>
   </file>
   <file name="blinky.c">
    <text>#include &quot;qpc.h&quot;
#include &quot;bsp.h&quot;
#include &quot;blinky.h&quot;
#include &quot;led.h&quot;
#include &quot;xdc/runtime/System.h&quot;

Q_DEFINE_THIS_MODULE(&quot;blinky&quot;)

$declare(Blinky::Blinky)

static Blinky Blinky_inst;
$define(Blinky::AO_Blinky)

$define(Blinky::Blinky_ctor)
$define(Blinky::Blinky)
</text>
   </file>
  </directory>
 </package>
 <extern_package file="./../bsp/bsp.qmp"/>
</model>
